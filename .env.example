# Server (Vercel API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# Comma-separated extra origins allowed by CORS (Android WebView origins are always allowed)
ALLOWED_ORIGINS=

# Client (Vite). Leave empty for web (same-origin /api); Android builds MUST set this.
VITE_API_BASE_URL=
