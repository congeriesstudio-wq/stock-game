{
  "name": "stock-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "dev:api": "npx --yes vercel@61.0.0 dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:android": "vite build --mode android && cap sync android",
    "android:debug": "npm run build:android && cd android && ./gradlew assembleDebug",
    "android:release": "npm run build:android && cd android && ./gradlew assembleRelease bundleRelease",
    "cap:sync": "cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@supabase/supabase-js": "^2.57.0",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
